{
    "name": "test-nuxt",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "nuxt build",
        "typecheck": "nuxt typecheck",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "check": "npm run test && npm run typecheck && npm run build",
        "check:deploy": "npm run check && npm run test:e2e",
        "dev": "NODE_OPTIONS=--no-deprecation CLOUDFLARE_ENV=dev nuxt dev",
        "generate": "nuxt generate",
        "preview": "npm run build && wrangler dev --config wrangler.jsonc --env dev",
        "postinstall": "nuxt prepare",
        "deploy": "npm run build && wrangler deploy --config wrangler.jsonc --env=\"\"",
        "cf-typegen": "wrangler types",
        "db:create": "wrangler d1 create prayers-db",
        "db:list": "wrangler d1 list",
        "db:info": "wrangler d1 info prayers-db",
        "db:migration": "wrangler d1 migrations create prayers-db",
        "db:migrate:local": "wrangler d1 migrations apply PRAYERS --env dev --local",
        "db:migrate:remote": "wrangler d1 migrations apply prayers-db --remote",
        "db:migrate:status": "wrangler d1 migrations list prayers-db",
        "db:query:local": "wrangler d1 execute PRAYERS --env dev --local --command",
        "db:query:remote": "wrangler d1 execute prayers-db --remote --command",
        "db:file:local": "wrangler d1 execute PRAYERS --env dev --local --file",
        "db:file:remote": "wrangler d1 execute prayers-db --remote --file",
        "db:reset:local": "wrangler d1 execute PRAYERS --env dev --local --file=./db/dev/reset.sql",
        "db:schema": "echo \"Use npm run db:migrate:local or npm run db:fresh. db/dev/schema.sql is only a local reference reset schema.\"",
        "db:seed": "wrangler d1 execute PRAYERS --env dev --local --file=./db/dev/seed.sql",
        "db:fresh": "npm run db:reset:local && npm run db:migrate:local && npm run db:seed",
        "db:seed:local": "wrangler d1 execute PRAYERS --env dev --local --file=./db/dev/seed.sql",
        "db:seed:remote": "wrangler d1 execute prayers-db --remote --file=./db/dev/seed.sql",
        "db:export": "wrangler d1 export prayers-db --remote --output backup.sql",
        "db:export:schema": "wrangler d1 export prayers-db --remote --output schema.sql --no-data",
        "db:shell": "sqlite3 .wrangler/state/v3/d1/miniflare-D1DatabaseObject/*.sqlite",
        "db:types": "wrangler types"
    },
    "dependencies": {
        "@chenglou/pretext": "^0.0.4",
        "nuxt": "^4.3.1",
        "nuxt-auth-utils": "^0.5.29",
        "tesseract.js": "^7.0.0",
        "vue": "^3.5.30",
        "vue-draggable-plus": "^0.6.1",
        "vue-router": "^4.6.4"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20260317.1",
        "@playwright/test": "^1.61.1",
        "@types/node": "^25.4.0",
        "nitro-cloudflare-dev": "^0.2.2",
        "nitropack": "^2.13.1",
        "typescript": "^5.9.3",
        "vitest": "^3.2.4",
        "vue-tsc": "^3.1.5",
        "wrangler": "^4.72.0"
    }
}
